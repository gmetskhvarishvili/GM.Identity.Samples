{
  "ConnectionStrings": {
    "ApplicationDatabase": "Host=localhost;Port=5432;Database=GMIdentitySample;Username=postgres;Password=123456"
  },
  "OAuth": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
      "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET",
      "AuthorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
      "TokenEndpoint": "https://oauth2.googleapis.com/token",
      "Scope": "openid email profile",
      "TokenName": "id_token"
    },
    "Facebook": {
      "ClientId": "YOUR_FACEBOOK_APP_ID",
      "ClientSecret": "YOUR_FACEBOOK_APP_SECRET",
      "AuthorizationEndpoint": "https://www.facebook.com/v20.0/dialog/oauth",
      "TokenEndpoint": "https://graph.facebook.com/v20.0/oauth/access_token",
      "UserDetailsEndpoint": "https://graph.facebook.com/me",
      "Scope": "email public_profile",
      "TokenName" : "access_token"
    }
  },
  "ApiServices": {
    "OTPAPIService": {
      "BaseUrl": "http://localhost:5250/api/v1.0/",
      "Headers": {
        "X-Client-Id": "abc123",
        "X-Environment": "Test"
      },
      "RetryPolicy": {
        "RetryCount": 3
      },
      "CircuitBreakerPolicy": {
        "FailureThreshold": 5,
        "BreakDuration": "00:00:30"
      },
      "TimeoutPolicy": {
        "Timeout": "00:00:10"
      },
      "FallbackPolicy": {
        "UseFallback": true,
        "FallbackResponseBody": "{\"message\":\"fallback response\"}"
      },
      "HedgingPolicy": {
        "EnableHedging": true,
        "HedgingAttempts": 2,
        "HedgingDelay": "00:00:00.100"
      },
      "Authorization": {
        "UseAuthorization": true,
        "Scheme": "Basic",
        "Username": "myuser",
        "Password": "mypassword"
      },
      "Caching": {
        "EnableCaching": true,
        "CacheDuration": "00:05:00"
      }
    }
  },
  "AllowedHosts": "*",
  "SwaggerDocOptions": {
    "Title": "GM API",
    "Description": "GM Sample Identity API",
    "Contact": {
      "Name": "Giorgi Metskhvarishvili",
      "Email": "gmetskhvarishvili95@gmail.com",
      "Url": "https://metskhvarishvili.com"
    },
    "License": {
      "Name": "License",
      "Url": "https://opensource.org/licenses/MIT"
    },
    "Authorization": {
      "Name": "Authorization",
      "Scheme": "Bearer",
      "Authority": "https://localhost:7000",
      "TokenEndpoint": "https://localhost:7000/connect/token",
      "ApiEndpoint": "https://localhost:7000/api/v1.0/",
      "ClientName": "swaggerui",
      "ClientSecret": "secret",
      "RequiredScopes": "openid profile roles application",
      "Flows": [
        "password",
        "clientCredentials"
      ]
    },
    "Headers": [
      "Accept-Language",
      "Authorization"
    ]
  },
  "Serilog": {
    "Using": [
      "Serilog",
      "Serilog.Sinks.Async",
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Graylog",
      "Serilog.Enrichers.HttpContext"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Migrations": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.EntityFrameworkCore.Model.Validation": "Error"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithHttpContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:G} {Level:u3} {Message:lj}{NewLine:1}{Exception:1}"
        }
      }
    ]
  }
}