<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <!-- YARP reverse proxy + GM edge rate limiting, driven from configuration. -->
        <PackageReference Include="GM.Gateway" Version="1.3.0" />

        <!-- Redis-backed counter store + distributed lock for cross-instance rate limiting. -->
        <PackageReference Include="GM.Caching.Redis" Version="1.0.1" />
        <PackageReference Include="GM.Identity" Version="1.3.0" />
        <PackageReference Include="StackExchange.Redis" Version="2.13.17" />

        <!-- Distributed tracing/metrics so a request is one trace across the gateway and the API. -->
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.12.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.12.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.12.0" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
        <PackageReference Include="GM.DistributedLock.Redis" Version="1.0.2" />
        <PackageReference Include="GM.RateLimiting.Redis" Version="1.0.1" />

        <!-- Liveness/readiness endpoints for the edge. -->
        <PackageReference Include="GM.HealthChecks" Version="1.0.2" />
        <PackageReference Include="GM.HealthChecks.Caching" Version="1.0.2" />
        <PackageReference Include="GM.HealthChecks.DistributedLock" Version="1.0.2" />

        <!-- Swagger UI at the root, rendering the proxied Identity API's OpenAPI document. -->
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    </ItemGroup>

</Project>
