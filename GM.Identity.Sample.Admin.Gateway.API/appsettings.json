{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },

  "Documentation": {
    "Backend": "https://localhost:7122/swagger/v1/swagger.json",
    "Title": "GM Identity Admin Gateway",
    "Description": "Admin gateway — exposes the full Identity API.",
    "IncludeAll": true
  },

  "ReverseProxy": {
    "Routes": {
      "accounts": {
        "ClusterId": "identity-api",
        "Match": { "Path": "/connect/{**catch-all}" },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "clients": {
        "ClusterId": "identity-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/{version}/clients/{**catch-all}" },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "operations": {
        "ClusterId": "identity-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/{version}/operations/{**catch-all}" },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "permissions": {
        "ClusterId": "identity-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/{version}/permissions/{**catch-all}" },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "roles": {
        "ClusterId": "identity-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/{version}/roles/{**catch-all}" },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "scopes": {
        "ClusterId": "identity-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/{version}/scopes/{**catch-all}" },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "users": {
        "ClusterId": "identity-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/{version}/users/{**catch-all}" },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      }
    },
    "Clusters": {
      "identity-api": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "HttpRequest": {
          "Version": "1.1",
          "VersionPolicy": "RequestVersionExact"
        },
        "Destinations": {
          "primary": { "Address": "https://localhost:7122/" }
        }
      }
    }
  },

  "RateLimiting": {
    "Policies": {
      "api": { "Algorithm": "FixedWindow", "PermitLimit": 60, "Window": "00:01:00" }
    }
  }
}
