{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Urls": "https://localhost:7236;http://localhost:7237",

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },

  "Documentation": {
    "Backend": "https://localhost:7122/swagger/v1/swagger.json",
    "Title": "GM Identity Admin Gateway",
    "Description": "Admin gateway — exposes the full Identity API.",
    "IncludeAll": true,
    "Exclude": [ "/connect/authz", "/api/me" ],
    "Rewrites": [
      { "Path": "/me", "FromPath": "/api/me", "Method": "get", "Tag": "Me", "Summary": "Current user (resolved from the access token)." },
      { "Path": "/me/sessions", "FromPath": "/api/me/Sessions", "Method": "get", "Tag": "Me", "Summary": "Current user's sessions (resolved from the access token)." },
      { "Path": "/me/permissions", "FromPath": "/api/me/Permissions", "Method": "get", "Tag": "Me", "Summary": "Names of every permission the current user holds, to cache and check locally." }
    ],
    "HiddenHeaders": [ "X-User-Id", "X-Client-Id", "X-Session-Id", "X-Tenant-Id", "X-Forwarded-For", "X-Forwarded-User-Agent" ]
  },

  "ReverseProxy": {
    "Routes": {
      "accounts": {
        "ClusterId": "identity-api",
        "Match": { "Path": "/connect/{**catch-all}" },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "well-known": {
        "ClusterId": "identity-api",
        "Match": { "Path": "/.well-known/{**catch-all}", "Methods": [ "GET" ] },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "clients": {
        "ClusterId": "identity-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/{version}/clients/{**catch-all}" },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "consentdocuments": {
        "ClusterId": "identity-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/{version}/consentdocuments/{**catch-all}" },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "domainevents": {
        "ClusterId": "identity-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/{version}/domainevents/{**catch-all}" },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "operations": {
        "ClusterId": "identity-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/{version}/operations/{**catch-all}" },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "me": {
        "ClusterId": "identity-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/me", "Methods": [ "GET" ] },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "me-sessions": {
        "ClusterId": "identity-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/me/sessions", "Methods": [ "GET" ] },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "me-permissions": {
        "ClusterId": "identity-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/me/permissions", "Methods": [ "GET" ] },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "permissions": {
        "ClusterId": "identity-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/{version}/permissions/{**catch-all}" },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "roles": {
        "ClusterId": "identity-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/{version}/roles/{**catch-all}" },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "scopes": {
        "ClusterId": "identity-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/{version}/scopes/{**catch-all}" },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "users": {
        "ClusterId": "identity-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/{version}/users/{**catch-all}" },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "service-demo-public": {
        "ClusterId": "service-api",
        "Match": { "Path": "/api/demo/public", "Methods": [ "GET" ] },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "service-demo": {
        "ClusterId": "service-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/demo/{**catch-all}" },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      }
    },
    "Clusters": {
      "identity-api": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "HttpRequest": {
          "Version": "1.1",
          "VersionPolicy": "RequestVersionExact"
        },
        "Destinations": {
          "primary": { "Address": "https://localhost:7122/" }
        }
      },
      "service-api": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "HttpRequest": {
          "Version": "1.1",
          "VersionPolicy": "RequestVersionExact"
        },
        "Destinations": {
          "primary": { "Address": "https://localhost:7300/" }
        }
      }
    }
  },

  "RateLimiting": {
    "Policies": {
      "api": { "Algorithm": "FixedWindow", "PermitLimit": 60, "Window": "00:01:00" }
    }
  }
}
