{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiServices": {
    "PermissionsService": {
      "BaseUrl": "https://localhost:7082",
      "Headers": {
        "X-Client-Id": "abc123",
        "X-Environment": "Test"
      },
      "RetryPolicy": {
        "RetryCount": 3
      },
      "CircuitBreakerPolicy": {
        "FailureThreshold": 5,
        "BreakDuration": "00:00:30"
      },
      "TimeoutPolicy": {
        "Timeout": "00:00:10"
      },
      "FallbackPolicy": {
        "UseFallback": true,
        "FallbackResponseBody": "{\"message\":\"fallback response\"}"
      },
      "HedgingPolicy": {
        "EnableHedging": true,
        "HedgingAttempts": 2,
        "HedgingDelay": "00:00:00.100"
      },
      "Authorization": {
        "UseAuthorization": true,
        "Scheme": "Basic",
        "Username": "myuser",
        "Password": "mypassword"
      },
      "Caching": {
        "EnableCaching": true,
        "CacheDuration": "00:05:00"
      }
    }
  }
}
