{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Urls": "https://localhost:7225;http://localhost:5031",

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },

  "Documentation": {
    "Backend": "https://localhost:7122/swagger/v1/swagger.json",
    "Title": "GM Identity Gateway",
    "Description": "Edge gateway — exposes Accounts and user creation.",
    "IncludeAll": false,
    "HiddenHeaders": [ "X-User-Id", "X-Client-Id", "X-Session-Id", "X-Tenant-Id", "X-Forwarded-For", "X-Forwarded-User-Agent" ],
    "Exclude": [ "/connect/authz" ],
    "Include": [
      { "PathPrefix": "/connect" },
      { "Path": "/api/users", "Methods": [ "post" ] }
    ],
    "Rewrites": [
      {
        "Path": "/me",
        "FromPath": "/api/me",
        "Method": "get",
        "Tag": "Me",
        "Summary": "Current user (resolved from the access token)."
      },
      {
        "Path": "/me/sessions",
        "FromPath": "/api/me/Sessions",
        "Method": "get",
        "Tag": "Me",
        "Summary": "Current user's sessions (resolved from the access token)."
      },
      {
        "Path": "/me/permissions",
        "FromPath": "/api/me/Permissions",
        "Method": "get",
        "Tag": "Me",
        "Summary": "Names of every permission the current user holds, to cache and check locally."
      }
    ]
  },

  "ReverseProxy": {
    "Routes": {
      "accounts": {
        "ClusterId": "identity-api",
        "Match": { "Path": "/connect/{**catch-all}" },
        "Metadata": { "RateLimitPolicy": "auth", "RateLimitPartition": "Ip,Endpoint" }
      },
      "well-known": {
        "ClusterId": "identity-api",
        "Match": { "Path": "/.well-known/{**catch-all}", "Methods": [ "GET" ] },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "users-create": {
        "ClusterId": "identity-api",
        "Match": { "Path": "/api/{version}/users", "Methods": [ "POST" ] },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "me": {
        "ClusterId": "identity-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/me", "Methods": [ "GET" ] },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "me-sessions": {
        "ClusterId": "identity-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/me/sessions", "Methods": [ "GET" ] },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "me-permissions": {
        "ClusterId": "identity-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/me/permissions", "Methods": [ "GET" ] },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "service-demo-public": {
        "ClusterId": "service-api",
        "Match": { "Path": "/api/demo/public", "Methods": [ "GET" ] },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      },
      "service-demo": {
        "ClusterId": "service-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/demo/{**catch-all}" },
        "Metadata": { "RateLimitPolicy": "api", "RateLimitPartition": "Ip,Endpoint" }
      }
    },
    "Clusters": {
      "identity-api": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "HttpRequest": {
          "Version": "1.1",
          "VersionPolicy": "RequestVersionExact"
        },
        "Destinations": {
          "primary": { "Address": "https://localhost:7122/" }
        }
      },
      "service-api": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "HttpRequest": {
          "Version": "1.1",
          "VersionPolicy": "RequestVersionExact"
        },
        "Destinations": {
          "primary": { "Address": "https://localhost:7300/" }
        }
      }
    }
  },

  "RateLimiting": {
    "Policies": {
      "api": { "Algorithm": "FixedWindow", "PermitLimit": 60, "Window": "00:01:00" },
      "auth": { "Algorithm": "FixedWindow", "PermitLimit": 10, "Window": "00:01:00" }
    }
  }
}
