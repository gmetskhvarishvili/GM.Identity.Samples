{
  "ConnectionStrings": {
    "ApplicationDatabase": "Host=localhost;Port=5432;Database=GMIdentitySample;Username=postgres;Password=123456"
  },
  "ProducerTopology": {
    "Routes": [
      {
        "MessageType": "GM.Identity.Sample.Domain.Events.Users.UserRegisteredIntegrationEvent, GM.Identity.Sample.Domain",  
        "Exchange": "gm.events",
        "Kind": "Topic",
        "RoutingKey": "user.registered"
      },
      {
        "MessageType": "GM.Identity.Sample.Domain.Events.Users.UserConfirmationInitiatedIntegrationEvent, GM.Identity.Sample.Domain",
        "Exchange": "gm.events",
        "Kind": "Topic",
        "RoutingKey": "user.confirmation.initiated"
      },
      {
        "MessageType": "GM.Identity.Sample.Domain.Events.Users.UserConfirmedIntegrationEvent, GM.Identity.Sample.Domain",
        "Exchange": "gm.events",
        "Kind": "Topic",
        "RoutingKey": "user.confirmed"
      }
    ] 
  },
  "Messaging": {
    "ServiceName": "GM.Identity.Sample.Producer.Worker",
    "RabbitMq": {
      "HostName":    "localhost",
      "Port":        5672,
      "VirtualHost": "/",
      "UserName":    "guest",
      "Password":    "guest"
    },
    "Retry": {
      "MaxAttempts":              5,
      "InitialDelayMilliseconds": 250
    },
    "CircuitBreaker": {
      "Enabled":                    true,
      "TrackingPeriodSeconds":      60,
      "PauseTimeSeconds":           30,
      "FailurePercentageThreshold": 25,
      "MinimumThreshold":           10
    },
    "OutboxRelay": {
      "BatchSize":              50,
      "MaxRetries":             5,
      "PollingIntervalSeconds": 5
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
