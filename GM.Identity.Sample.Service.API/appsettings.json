{
  "IdentityApi": {
    "BaseUrl": "https://localhost:7122/",
    "ClientId": "11111111-1111-1111-1111-111111111111",
    "ClientSecret": "secret",
    "IntrospectionCacheSeconds": 30
  },
  "Service": {
    "Name": "GM.Identity.Sample.Service.API"
  },
  "SwaggerDocOptions": {
    "Title": "GM Identity Sample Service API",
    "Description": "Resource-server sample: validates the provider's tokens and enforces permissions and scopes.",
    "Contact": {
      "Name": "Giorgi Metskhvarishvili",
      "Email": "gmetskhvarishvili95@gmail.com",
      "Url": "https://metskhvarishvili.com"
    },
    "License": {
      "Name": "License",
      "Url": "https://opensource.org/licenses/MIT"
    },
    "Authorization": {
      "Name": "Authorization",
      "Scheme": "Bearer",
      "Authority": "https://localhost:7122",
      "TokenEndpoint": "https://localhost:7122/connect/token",
      "ApiEndpoint": "https://localhost:7300/api/",
      "ClientName": "swaggerui",
      "ClientSecret": "secret",
      "RequiredScopes": "openid profile roles application",
      "Flows": [
        "password",
        "clientCredentials"
      ]
    },
    "Headers": [
      "Accept-Language",
      "Authorization",
      "X-Correlation-Id",
      "Idempotency-Key",
      "X-User-Id",
      "X-Client-Id",
      "X-Tenant-Id",
      "X-Session-Id",
      "X-Channel-Id",
      "X-Forwarded-For",
      "X-Forwarded-User-Agent"
    ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:G} {Level:u3} {Message:lj}{NewLine:1}{Exception:1}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
