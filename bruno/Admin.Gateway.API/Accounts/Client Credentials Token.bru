meta {
  name: Client Credentials Token
  type: http
  seq: 4
}

post {
  url: {{adminGateway}}/connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: ClientCredentials
  client_id: {{clientId}}
  client_secret: {{clientSecret}}
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("issues an access token", function () {
    const body = res.getBody();
    expect(body.accessToken ?? body.access_token).to.be.a("string").and.not.empty;
  });
}
