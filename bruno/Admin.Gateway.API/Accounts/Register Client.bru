meta {
  name: Register Client
  type: http
  seq: 7
}

post {
  url: {{adminGateway}}/connect/register
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "client_name": "bruno-spa",
    "redirect_uris": [ "{{redirectUri}}" ],
    "scope": "openid profile",
    "backchannel_logout_uri": "https://localhost:5001/logout/backchannel",
    "frontchannel_logout_uri": "https://localhost:5001/logout/frontchannel",
    "require_consent": false
  }
}

script:post-response {
  const body = res.getBody() || {};
  bru.setEnvVar("codeClientId", body.client_id);
  bru.setEnvVar("codeClientSecret", body.client_secret);
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns the new client's credentials", function () {
    expect(res.getBody()).to.include.keys("client_id", "client_secret");
  });
}
