meta {
  name: Get Client Scopes
  type: http
  seq: 12
}

get {
  url: {{adminGateway}}/api/v1/Clients/{{createdClientId}}/Scopes?currentPage=1&pageSize={{pageSize}}&orderBy=CreatedAt desc&visibility=All
  body: none
  auth: bearer
}

params:query {
  currentPage: 1
  pageSize: {{pageSize}}
  orderBy: CreatedAt desc
  visibility: All
  ~lastKeyProperty: Id
  ~lastKeyValue: {{lastKeyValue}}
  ~includeTotalCount: false
  ~createdAtFrom: 01/01/2026 00:00:00
  ~createdAtTo: 31/12/2026 23:59:59
  ~updatedAtFrom: 01/01/2026 00:00:00
  ~updatedAtTo: 31/12/2026 23:59:59
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
