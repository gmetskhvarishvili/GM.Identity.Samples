meta {
  name: Get Client Sessions
  type: http
  seq: 15
}

get {
  url: {{adminGateway}}/api/v1/Clients/{{createdClientId}}/Sessions?currentPage=1&pageSize={{pageSize}}&orderBy=CreatedAt desc&visibility=All
  body: none
  auth: bearer
}

params:query {
  currentPage: 1
  pageSize: {{pageSize}}
  orderBy: CreatedAt desc
  visibility: All
  ~lastKeyProperty: Id
  ~lastKeyValue: {{lastKeyValue}}
  ~includeTotalCount: false
  ~createdAtFrom: 01/01/2026 00:00:00
  ~createdAtTo: 31/12/2026 23:59:59
  ~updatedAtFrom: 01/01/2026 00:00:00
  ~updatedAtTo: 31/12/2026 23:59:59
  ~id: {{clientSessionId}}
  ~isRevoked: false
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  const items = res.getBody() || [];
  if (items.length > 0) bru.setEnvVar("clientSessionId", items[0].id);
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
