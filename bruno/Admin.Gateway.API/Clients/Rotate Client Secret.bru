meta {
  name: Rotate Client Secret
  type: http
  seq: 11
}

post {
  url: {{adminGateway}}/api/v1/Clients/{{createdClientId}}/Secret/Rotate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "secret": "bruno-secret-rotated"
  }
}

docs {
  Replaces the client's secret with the one sent (only its hash is stored) and revokes the client's active
  sessions.
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
