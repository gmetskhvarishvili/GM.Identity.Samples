meta {
  name: Get Consent Document Details
  type: http
  seq: 3
}

get {
  url: {{adminGateway}}/api/v1/ConsentDocuments/{{consentDocumentId}}?visibility=All
  body: none
  auth: bearer
}

params:query {
  visibility: All
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns the requested row", function () {
    expect(res.getBody().id).to.equal(bru.getEnvVar("consentDocumentId"));
  });
}
