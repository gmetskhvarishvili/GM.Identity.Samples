meta {
  name: Get Domain Events
  type: http
  seq: 1
}

get {
  url: {{adminGateway}}/api/v1/DomainEvents?currentPage=1&pageSize={{pageSize}}&orderBy=CreatedAt desc&visibility=All
  body: none
  auth: bearer
}

params:query {
  currentPage: 1
  pageSize: {{pageSize}}
  orderBy: CreatedAt desc
  visibility: All
  ~lastKeyProperty: Id
  ~lastKeyValue: {{lastKeyValue}}
  ~includeTotalCount: false
  ~createdAtFrom: 01/01/2026 00:00:00
  ~createdAtTo: 31/12/2026 23:59:59
  ~updatedAtFrom: 01/01/2026 00:00:00
  ~updatedAtTo: 31/12/2026 23:59:59
  ~userId: {{userId}}
  ~clientId: {{clientId}}
  ~sessionId: {{userSessionId}}
  ~tenantId: 00000000-0000-0000-0000-000000000000
  ~ipAddress: ::1
  ~channelId: {{channelId}}
  ~eventType: GMPermissionCreatedDomainEvent
  ~occurredFrom: 01/01/2026 00:00:00
  ~occurredTo: 31/12/2026 23:59:59
  ~createdFrom: 01/01/2026 00:00:00
  ~createdTo: 31/12/2026 23:59:59
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns a page of rows", function () {
    const items = res.getBody();
    expect(items).to.be.an("array");
    expect(items.length).to.be.at.most(Number(bru.getEnvVar("pageSize")));
    if (items.length) expect(items[0]).to.include.keys("id", "eventType", "occurredOn");
  });

  test("sends the X-Pagination header", function () {
    const page = JSON.parse(res.getHeader("x-pagination"));
    expect(page.currentPage).to.equal(1);
  });
}
