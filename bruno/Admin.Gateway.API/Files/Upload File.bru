meta {
  name: Upload File
  type: http
  seq: 1
}

post {
  url: {{adminGateway}}/api/v1/files
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:multipart-form {
  file: @file(sample-files/avatar.pdf)
}

script:post-response {
  if (res.getStatus() === 200) bru.setEnvVar("fileId", res.getBody().id);
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns the stored file", function () {
    const body = res.getBody();
    expect(body.id).to.match(/^[0-9a-f-]{36}$/i);
    expect(body).to.include({ fileName: "avatar.pdf", contentType: "application/pdf" });
  });
}

docs {
  One multipart `file`, streamed through the gateway to the files API. Saves its id as fileId — the id a user's
  profileImageFileId points at.
}
