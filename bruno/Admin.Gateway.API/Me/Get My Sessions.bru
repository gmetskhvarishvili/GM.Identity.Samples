meta {
  name: Get My Sessions
  type: http
  seq: 2
}

get {
  url: {{adminGateway}}/me/sessions
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns a list of sessions", function () {
    expect(res.getBody()).to.be.an("array");
  });
}
