meta {
  name: Add Operation
  type: http
  seq: 2
}

post {
  url: {{adminGateway}}/api/v1/Operations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "{{operationName}}",
    "description": "Created by the Bruno collection"
  }
}

vars:pre-request {
  operationName: operation 1
}

script:pre-request {
  // A fresh name per run, so the unique-name rule never trips.
  bru.setEnvVar("operationName", `bruno:operation-${Date.now()}`);
}

script:post-response {
  bru.setEnvVar("operationId", res.getBody());
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("returns the new id", function () {
    expect(res.getBody()).to.match(/^[0-9a-f-]{36}$/i);
  });
}
