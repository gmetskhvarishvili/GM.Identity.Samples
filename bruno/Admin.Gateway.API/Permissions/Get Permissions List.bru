meta {
  name: Get Permissions List
  type: http
  seq: 1
}

get {
  url: {{adminGateway}}/api/v1/Permissions?currentPage=1&pageSize={{pageSize}}&orderBy=CreatedAt desc&visibility=All
  body: none
  auth: bearer
}

params:query {
  currentPage: 1
  pageSize: {{pageSize}}
  orderBy: CreatedAt desc
  visibility: All
  ~lastKeyProperty: Id
  ~lastKeyValue: {{lastKeyValue}}
  ~includeTotalCount: false
  ~createdAtFrom: 01/01/2026 00:00:00
  ~createdAtTo: 31/12/2026 23:59:59
  ~updatedAtFrom: 01/01/2026 00:00:00
  ~updatedAtTo: 01/01/2026 00:00:00
  ~id: {{permissionId}}
  ~name: GetPermissionsList
  ~description: GetPermissionsList
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  permissionId: 39a82193-0505-44b7-8b58-c30af05d719e
  lastKeyValue: 06fe4f7c-9e1f-4a2b-975c-4ddfa16a1f01
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("returns a page of permissions", function () {
    const items = res.getBody();
    expect(items).to.be.an("array").that.is.not.empty;
    expect(items.length).to.be.at.most(Number(bru.getEnvVar("pageSize")));
    expect(items[0]).to.include.keys("id", "name", "description");
  });
  
  test("sends the X-Pagination header", function () {
    const page = JSON.parse(res.getHeader("x-pagination"));
    expect(page.currentPage).to.equal(1);
    expect(page.totalCount).to.be.above(0);
  });
}
