meta {
  name: Add Role Permission
  type: http
  seq: 13
}

post {
  url: {{adminGateway}}/api/v1/Roles/{{roleId}}/Permissions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "permissionId": "{{permissionId}}"
  }
}

vars:pre-request {
  roleId: 92b8e240-dc3a-44d8-be17-fc96f270a4a2
  permissionId: 34017f95-7c6c-49bb-a240-9a883774d411
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
