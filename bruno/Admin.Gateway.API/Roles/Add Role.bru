meta {
  name: Add Role
  type: http
  seq: 2
}

post {
  url: {{adminGateway}}/api/v1/Roles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "{{roleName}}",
    "rolePermissions": [
      { "permissionId": "{{permissionId}}" }
    ]
  }
}

script:pre-request {
  // A fresh name per run, so the unique-name rule never trips.
  bru.setEnvVar("roleName", `bruno-role-${Date.now()}`);
}

script:post-response {
  bru.setEnvVar("roleId", res.getBody());
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns the new id", function () {
    expect(res.getBody()).to.match(/^[0-9a-f-]{36}$/i);
  });
}
