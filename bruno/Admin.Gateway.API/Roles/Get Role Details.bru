meta {
  name: Get Role Details
  type: http
  seq: 3
}

get {
  url: {{adminGateway}}/api/v1/Roles/{{roleId}}?visibility=All
  body: none
  auth: bearer
}

params:query {
  visibility: All
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  roleId: 92b8e240-dc3a-44d8-be17-fc96f270a4a2
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("returns the requested row", function () {
    expect(res.getBody().id).to.equal(bru.getEnvVar("roleId"));
  });
}
