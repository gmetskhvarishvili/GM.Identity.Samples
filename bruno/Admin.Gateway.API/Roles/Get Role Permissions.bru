meta {
  name: Get Role Permissions
  type: http
  seq: 11
}

get {
  url: {{adminGateway}}/api/v1/Roles/{{roleId}}/Permissions?currentPage=1&pageSize={{pageSize}}&orderBy=CreatedAt desc
  body: none
  auth: bearer
}

params:query {
  currentPage: 1
  pageSize: {{pageSize}}
  orderBy: CreatedAt desc
  ~lastKeyProperty: Id
  ~lastKeyValue: {{lastKeyValue}}
  ~includeTotalCount: false
  ~createdAtFrom: 01/01/2026 00:00:00
  ~createdAtTo: 31/12/2026 23:59:59
  ~updatedAtFrom: 01/01/2026 00:00:00
  ~updatedAtTo: 31/12/2026 23:59:59
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  roleId: 92b8e240-dc3a-44d8-be17-fc96f270a4a2
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
