meta {
  name: Revoke Token
  type: http
  seq: 1
}

post {
  url: {{adminGateway}}/connect/revoke
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  token: {{refreshToken}}
  client_id: {{clientId}}
  client_secret: {{clientSecret}}
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
