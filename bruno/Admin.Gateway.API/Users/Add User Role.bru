meta {
  name: Add User Role
  type: http
  seq: 17
}

post {
  url: {{adminGateway}}/api/v1/Users/{{userId}}/Roles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "roleId": "{{roleId}}"
  }
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
