meta {
  name: Record User Consent
  type: http
  seq: 23
}

post {
  url: {{adminGateway}}/api/v1/Users/{{userId}}/Consents
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "consentType": "{{consentType}}",
    "documentVersion": "2.0"
  }
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
