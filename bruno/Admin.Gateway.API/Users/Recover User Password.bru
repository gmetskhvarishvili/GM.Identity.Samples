meta {
  name: Recover User Password
  type: http
  seq: 32
}

post {
  url: {{adminGateway}}/api/v1/Users/Password/Recover
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "email": "{{userName}}@test.local",
    "code": "123456",
    "password": "Bruno#2026pass-recovered"
  }
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
