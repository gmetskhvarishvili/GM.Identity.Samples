meta {
  name: Register User Passkey
  type: http
  seq: 28
}

post {
  url: {{adminGateway}}/api/v1/Users/{{userId}}/Passkeys
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "credentialId": "{{passkeyCredentialId}}",
    "publicKeySpkiBase64": "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE",
    "name": "Bruno test key"
  }
}

script:pre-request {
  // A fresh credential id per run — passkey credential ids are unique.
  bru.setEnvVar("passkeyCredentialId", `bruno-credential-${Date.now()}`);
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
