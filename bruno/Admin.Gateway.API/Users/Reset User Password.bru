meta {
  name: Reset User Password
  type: http
  seq: 31
}

post {
  url: {{adminGateway}}/api/v1/Users/Password/Reset
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "email": "{{userName}}@test.local",
    "notificationType": 0
  }
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
