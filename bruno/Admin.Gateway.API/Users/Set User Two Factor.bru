meta {
  name: Set User Two Factor
  type: http
  seq: 24
}

put {
  url: {{adminGateway}}/api/v1/Users/{{userId}}/TwoFactor/0
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "enabled": true
  }
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
