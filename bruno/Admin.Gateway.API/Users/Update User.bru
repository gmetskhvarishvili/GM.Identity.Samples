meta {
  name: Update User
  type: http
  seq: 4
}

put {
  url: {{adminGateway}}/api/v1/Users/{{userId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "username": "{{userName}}",
    "email": "{{userName}}@test.local",
    "phoneNumber": "+995555000001",
    "personalInfo": {
      "firstName": "Bruno",
      "lastName": "Tester-updated",
      "personalNumber": "01001000001",
      "birthDate": "1990-01-01T00:00:00Z"
    }
  }
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
