meta {
  name: Approve Device
  type: http
  seq: 11
}

post {
  url: {{gateway}}/connect/device
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  user_code: {{userCode}}
  username: {{username}}
  password: {{password}}
  approve: true
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
