meta {
  name: Begin Passkey Login
  type: http
  seq: 13
}

post {
  url: {{gateway}}/connect/passkey/begin
  body: json
  auth: none
}

body:json {
  {
    "userName": "{{username}}"
  }
}

script:post-response {
  bru.setEnvVar("passkeyChallenge", res.getBody());
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns a challenge", function () {
    expect(res.getBody()).to.be.a("string").and.not.empty;
  });
}
