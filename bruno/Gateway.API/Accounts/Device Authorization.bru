meta {
  name: Device Authorization
  type: http
  seq: 10
}

post {
  url: {{gateway}}/connect/device_authorization
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  client_id: {{clientId}}
  client_secret: {{clientSecret}}
  scope: openid profile
}

script:post-response {
  const body = res.getBody() || {};
  bru.setEnvVar("deviceCode", body.device_code);
  bru.setEnvVar("userCode", body.user_code);
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns a device and user code", function () {
    expect(res.getBody()).to.include.keys("device_code", "user_code", "verification_uri");
  });
}
