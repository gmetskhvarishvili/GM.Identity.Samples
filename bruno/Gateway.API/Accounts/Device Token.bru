meta {
  name: Device Token
  type: http
  seq: 12
}

post {
  url: {{gateway}}/connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: urn:ietf:params:oauth:grant-type:device_code
  device_code: {{deviceCode}}
  client_id: {{clientId}}
  client_secret: {{clientSecret}}
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("issues an access token", function () {
    const body = res.getBody();
    expect(body.accessToken ?? body.access_token).to.be.a("string").and.not.empty;
  });
}
