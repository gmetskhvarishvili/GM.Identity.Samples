meta {
  name: JWKS
  type: http
  seq: 19
}

get {
  url: {{gateway}}/.well-known/jwks.json
  body: none
  auth: none
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("publishes signing keys", function () {
    expect(res.getBody().keys).to.be.an("array").that.is.not.empty;
  });
}
