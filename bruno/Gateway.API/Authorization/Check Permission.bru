meta {
  name: Check Permission
  type: http
  seq: 1
}

get {
  url: {{gateway}}/connect/authz/permission?userId={{userId}}&name=GetPermissionsList
  body: none
  auth: none
}

params:query {
  userId: {{userId}}
  name: GetPermissionsList
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("answers with a boolean", function () {
    expect(res.getBody()).to.be.a("boolean");
  });
}
