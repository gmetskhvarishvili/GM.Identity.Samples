meta {
  name: Check Scope
  type: http
  seq: 2
}

get {
  url: {{gateway}}/connect/authz/scope?clientId={{clientId}}&operation=read:identity
  body: none
  auth: none
}

params:query {
  clientId: {{clientId}}
  operation: read:identity
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("answers with a boolean", function () {
    expect(res.getBody()).to.be.a("boolean");
  });
}
