meta {
  name: Get Me
  type: http
  seq: 1
}

get {
  url: {{gateway}}/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns the signed-in user", function () {
    expect(res.getBody()).to.include.keys("id", "email");
  });
}
