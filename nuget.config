<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      A repo-local feed holding the GM.* package versions this sample pins that are not (yet) on
      nuget.org (see ./nuget-local). Bundling them keeps `docker compose up` / CI self-contained:
      restore finds these locally and everything else from nuget.org. Remove this source once the
      referenced versions are published to nuget.org.
    -->
    <add key="local" value="./nuget-local" />
  </packageSources>
</configuration>
