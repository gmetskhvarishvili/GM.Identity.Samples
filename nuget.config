<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      A repo-local feed holding the GM.* package versions this sample pins that are not (yet) on
      nuget.org (see ./nuget-local). Bundling them keeps `docker compose up` / CI self-contained:
      inside a container / CI runner (which have no machine-wide feed) restore finds these locally and
      everything else from nuget.org. On a dev machine that also has a global GM.* feed, both are used.
      Deliberately NOT using <clear/> so a developer's existing machine-wide feeds keep working.
      Remove this source once the referenced versions are published to nuget.org.
    -->
    <add key="local" value="./nuget-local" />
  </packageSources>
</configuration>
